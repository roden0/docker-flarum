{
    "name": "flarum/flarum",
    "description": "Delightfully simple forum software.",
    "type": "project",
    "keywords": [
        "forum",
        "discussion"
    ],
    "homepage": "https://flarum.org/",
    "license": "MIT",
    "authors": [
        {
            "name": "Flarum",
            "email": "info@flarum.org",
            "homepage": "https://flarum.org/team"
        }
    ],
    "support": {
        "issues": "https://github.com/flarum/core/issues",
        "source": "https://github.com/flarum/flarum",
        "docs": "https://docs.flarum.org/"
    },
    "require": {
        "flarum-lang/spanish": "^2.0",
        "flarum/approval": "*",
        "flarum/audit": "*",
        "flarum/bbcode": "*",
        "flarum/core": "^2.0.0",
        "flarum/deck": "*",
        "flarum/emoji": "*",
        "flarum/flags": "*",
        "flarum/gdpr": "*",
        "flarum/lang-english": "*",
        "flarum/likes": "*",
        "flarum/lock": "*",
        "flarum/markdown": "*",
        "flarum/mentions": "*",
        "flarum/messages": "*",
        "flarum/nicknames": "*",
        "flarum/statistics": "*",
        "flarum/sticky": "*",
        "flarum/subscriptions": "*",
        "flarum/suspend": "*",
        "flarum/tags": "*",
        "fof/formatting": "^2.0",
        "fof/links": "^2.0",
        "fof/merge-discussions": "^2.0",
        "fof/moderator-notes": "^2.0",
        "fof/polls": "^3.0",
        "fof/sitemap": "^3.0",
        "fof/split": "^2.0",
        "fof/terms": "^2.0",
        "fof/upload": "^2.1",
        "fof/user-directory": "^2.0",
        "foro/tema": "@dev"
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [{
        "name": "tema",
        "type": "path",
        "url": "extensions/tema",
        "options": {
            "symlink": false
        }
    }]
}
