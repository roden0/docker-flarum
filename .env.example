# Copia a .env para probar en local. En Coolify estas variables las genera el propio Coolify.
SERVICE_URL_FLARUM_8080=http://localhost:8080
SERVICE_USER_MARIADB=flarum
SERVICE_PASSWORD_MARIADB=cambia-esto
SERVICE_PASSWORD_MARIADBROOT=cambia-esto-tambien
SERVICE_PASSWORD_FLARUMADMIN=admin-local-123
FLARUM_ADMIN_EMAIL=admin@example.com
# Solo en local: añade el archivo que publica el puerto 8080. Coolify no tiene esta variable.
COMPOSE_FILE=docker-compose.yaml:docker-compose.local.yaml
